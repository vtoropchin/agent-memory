        <mxCell id="boxB" value="Доменная логика · internal/memory · всё за интерфейсами" style="rounded=1;arcSize=3;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#64748b;fontSize=11;fontStyle=2;" vertex="1" parent="1">
